# PostgreSQL Database
POSTGRES_DB=beatport2rss
POSTGRES_USER=db@beatport2rss.com
POSTGRES_PASSWORD=your_secure_password_here

# Beatport Credentials
BEATPORT_USERNAME=your_beatport_username
BEATPORT_PASSWORD=your_beatport_password

# Chromium Downloader
CHROMIUM_BASE_URL=https://download-chromium.appspot.com

# Token Interceptor
INTERCEPTOR_GRPC_URI=http://0.0.0.0:5000

# RabbitMQ
RABBITMQ_USERNAME=beatport2rss
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_HOSTNAME=rabbitmq
RABBITMQ_PORT=5672

# API
API_PORT=8080
WEB_PORT=8081
API_DB_CONNECTION=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# Web and email confirmation
EMAIL_CONFIRMATION_ENABLED=false
EMAIL_CONFIRMATION_LIFETIME=1.00:00:00
EMAIL_CONFIRMATION_PUBLIC_WEB_BASE_URL=
EMAIL_CONFIRMATION_ADMIN_USER_ID=
EMAIL_CONFIRMATION_TEMPLATE_ID=

# Resend
RESEND_API_TOKEN=your_resend_api_token

# Builder
BUILDER_DB_CONNECTION=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
BUILDER_RELEASES_RETENTION_IN_DAYS=100
BUILDER_DELETE_STALE_RELEASES_CRON=0 55 * * * ?
BUILDER_BUILD_RSS_FEED_CRON=0 0 * * * ?

# Collector
COLLECTOR_DB_CONNECTION=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
COLLECTOR_COLLECT_RELEASES_CRON=0 0 3 * * ?

# API JWT
JWT_ISSUER=beatport2rss
JWT_AUDIENCE=beatport2rss
JWT_SIGNING_KEY=your_signing_key_at_least_32_characters_long
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=2592000