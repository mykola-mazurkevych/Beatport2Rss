# PostgreSQL Database
POSTGRES_DB=beatport2rss
POSTGRES_USER=db@beatport2rss.com
POSTGRES_PASSWORD=your_secure_password_here

# Beatport Credentials
BEATPORT_USERNAME=your_beatport_username
BEATPORT_PASSWORD=your_beatport_password

# Chromium Downloader
CHROMIUM_BASE_URL=https://download-chromium.appspot.com

# Token Interceptor
INTERCEPTOR_GRPC_URI=http://0.0.0.0:5000

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_HOSTNAME=localhost
RABBITMQ_PORT=5672

# API
API_PORT=8080
API_DB_CONNECTION=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# API JWT
JWT_ISSUER=beatport2rss
JWT_AUDIENCE=beatport2rss
JWT_SIGNING_KEY=your_signing_key_at_least_32_characters_long
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=2592000